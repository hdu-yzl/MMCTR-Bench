# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Packaging and build output
*.egg-info/
*.egg
build/
dist/
wheels/

# Test, lint, type-check, and coverage caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Local Python environments
.venv/
venv/
env/

# Editors, local AI-assistant context, and operating-system metadata
.vscode/
.idea/
.codebuddy/
/AGENTS.md
/REFACTORING_PLAN.md
/MMCTR_Benchmark.pdf
/MMCTR_Benchmark*.pdf
/docs/MMCTR_Benchmark*.pdf
.codex/
.agents/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Notebook checkpoints
.ipynb_checkpoints/

# Local configuration, environment files, and secrets
.env
.env.*
!.env.example
configs/local/**
!configs/local/
!configs/local/paths.example.yaml

# Private and generated datasets; keep documentation and manifests
data/raw/**
!data/raw/**/
!data/raw/**/README.md
!data/raw/**/manifest.*
data/processed/**
!data/processed/**/
!data/processed/**/README.md
!data/processed/**/manifest.*

# Experiment, tuning, log, checkpoint, and generated report output
outputs/**
!outputs/.gitkeep
reports/figures/
checkpoints/
runs/
wandb/
mlruns/
ray_results/
*.log
*.pt
*.pth
*.ckpt

# Local experiment drivers and development reports
/scripts/run_ebnerd_id16*_once.py
/docs/legacy_tuning_history.yaml
/docs/data/antm2c-format-benchmark.json
# EB-NeRD manifests include fitted vocabularies; regenerate them with the data.
/data/processed/ebnerd/**/manifest.json

# Temporary files
.cache/
.tmp/
downloads/
*.tmp
*.temp
~$*
